{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListNamedSources",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::gitlab-registry",
        "arn:aws:s3:::gitlab-uploads",
        "arn:aws:s3:::gitlab-artifacts",
        "arn:aws:s3:::gitlab-lfs",
        "arn:aws:s3:::gitlab-packages"
      ]
    },
    {
      "Sid": "ReadSourceObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::gitlab-registry/*",
        "arn:aws:s3:::gitlab-uploads/*",
        "arn:aws:s3:::gitlab-artifacts/*",
        "arn:aws:s3:::gitlab-lfs/*",
        "arn:aws:s3:::gitlab-packages/*"
      ]
    },
    {
      "Sid": "InspectBackupBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:ListBucketMultipartUploads"
      ],
      "Resource": [
        "arn:aws:s3:::gitlab-backups"
      ]
    },
    {
      "Sid": "UploadAndVerifyArchives",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::gitlab-backups/*"
      ]
    }
  ]
}
